# ---------------------------------------------------------------- git / VCS
.git
.gitignore
.github

# ---------------------------------------------------------------- secrets & env
# Never bake credentials into an image; supply them via compose env / .env at runtime.
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# ---------------------------------------------------------------- local data (runtime state)
# Server ledger DBs, sessions, seeded secrets — recreated on boot, never shipped.
# NOTE: the top-level data/ directory holds the test swatch fixtures and is kept.
server/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# Transient verification harness output.
.verify/

# ---------------------------------------------------------------- heavy build artifacts
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist
build
.next
.expo
.expo-shared
web-build
*.tsbuildinfo

# ---------------------------------------------------------------- native projects (regenerated by prebuild)
android
ios

# ---------------------------------------------------------------- camera-engine workspace
# Separate Python/JS research workspace for the vision pipeline — not part of the
# backend image and not part of the API runtime.
camera-engine
camera_engine
**/camera-engine/**

# ---------------------------------------------------------------- agent/tooling workspaces
.agents
.claude
.scratch
skills-lock.json
AGENTS.md
CLAUDE.md
docs

# ---------------------------------------------------------------- test/report output
coverage
*.log

# ---------------------------------------------------------------- OS / editor metadata
.DS_Store
Thumbs.db
.idea
.vscode
*.swp
*.swo
