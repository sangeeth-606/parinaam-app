# ---------------------------------------------------------------------------
# Parinaam — local/self-hosted backend environment.
# Copy to `.env` and adjust. `.env` is gitignored and never baked into images.
#   cp .env.example .env
# Compose reads this file automatically (docker compose / docker-compose v2+).
# ---------------------------------------------------------------------------

# --- Database (REQUIRED) -----------------------------------------------------
# Parinaam has NO local PostgreSQL container. `docker compose` defines no `db`
# service; the API talks to the Supabase-hosted PostgreSQL below, which is the
# same database `parinaam-web` reads. Both apps therefore share one ledger, so a
# capture taken on the phone shows up on the dashboard with no copy step.
#
# REQUIRED: use the Supabase connection string (IPv4 pooler host, port 5432).
# Compose fails fast with a clear message if this is unset, rather than
# silently falling back to a second, divergent local database.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
PARINAAM_DB=postgres

# Optional administrator bootstrap password (at least 16 characters required).
PARINAAM_API_ADMIN_PASSWORD=Parinaam#Admin#2026

# --- REST API container -------------------------------------------------------
# Host-side binding for the API. Loopback by default; 0.0.0.0 to let the phone on
# the same Wi-Fi reach it (then use your LAN IP in the app's Settings → Sync URL).
API_BIND=127.0.0.1
# Host port mapped to the container's 8571. Override if 8571 is taken.
API_PORT=8571
# Optional Expo build-time API default. `npm start`/`npm run app:go` supplies
# the laptop LAN address automatically for a physical phone.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8571

# --- Demo seed / officer credential -------------------------------------------
# Password of the auto-seeded demo officers on first boot.
# All seeded demo accounts share this password.
# This is a local-development default only; replace it before any shared deployment.
PARINAAM_SEED_PASSWORD=Parinaam#2026
# Set to 1 to let the server load the realistic demo dataset when the DB is empty;
# default is 0 for an empty ledger (production safety). Loading demo data explicitly
# is also available via `docker compose run --rm seed` (idempotent — safe to re-run).
PARINAAM_SEED=0

# --- Camera-engine image service (Docker only) ------------------------------
# The Python/OpenCV engine is intentionally separate from the API image. It
# listens on loopback by default; a physical phone must use a trusted LAN binding
# and its host LAN IP in Settings -> CAMERA ENGINE.
ENGINE_BIND=127.0.0.1
ENGINE_PORT=8572
# Keep 0 for a field-safe service: the current printed profile is
# PENDING_VALIDATION. Set 1 only for the explicitly labelled SIH printed-mock
# demo; the app then marks resulting records as demo/unvalidated.
CAMERA_ENGINE_DEMO_MODE=0
# Expo build-time default used when the officer has not overridden the engine URL
# in Settings. Android emulator: http://10.0.2.2:8572
# The Expo tunnel publishes Metro only; it does not publish the camera-engine port.
EXPO_PUBLIC_CAMERA_ENGINE_URL=http://10.0.2.2:8572

# --- Running the API outside Docker (optional) -------------------------------
# When you run `npm run server` on the host against the containerised DB, set:
#   PARINAAM_DB=postgres
#   DATABASE_URL=postgres://parinaam:parinaam@127.0.0.1:55433/parinaam
# (host/port must match POSTGRES_BIND and POSTGRES_PORT above). Leave
# PARINAAM_DB unset to use the embedded node:sqlite file store instead
# (PARINAAM_SERVER_DB overrides its path, default server/data/parinaam-server.db).

# --- Running the API against a local file store (optional) -------------------
# PARINAAM_SERVER_DB=server/data/parinaam-server.db
# PARINAAM_API_PORT=8571

# Browser origins allowed by the API. Comma-separated exact origins; `*` echoes any
# origin and should be limited to trusted local development.
# PARINAAM_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-For.
# PARINAAM_TRUST_PROXY=false
